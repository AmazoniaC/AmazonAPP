# Copiar este archivo como .env y completar los valores.
# Windows PowerShell: Copy-Item .env.example .env
# Linux / Mac:        cp .env.example .env

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=la_contraseña_que_pusiste_al_instalar
DB_NAME=erp_amazonia

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001

# Secreto para firmar los tokens de sesión (JWT). Obligatorio: el servidor no
# arranca sin esto. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Dominio(s) del frontend que pueden llamar a esta API desde el navegador,
# separados por coma (ej: https://app.tuempresa.com). Opcional: si se deja
# vacío, la API acepta peticiones desde cualquier origen (cómodo en
# desarrollo, pero conviene restringirlo en producción).
CORS_ORIGIN=

# ── WhatsApp (opcional) ───────────────────────────────────────────────────────
# Código de país por defecto para números sin indicativo (57 = Colombia).
WA_COUNTRY_CODE=57
